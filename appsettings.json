{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ApplicationInsights": {
    "Enabled": false,
    "InstrumentationKey": "...",
    "ConnectionString": "..."
  },

  "Entra": {
    "Domain": "<your-domain>.ciamlogin.com",
    "Instance": "https://{tenantId}.ciamlogin.com/",
    "TenantId": "<your TenantID>",
    "ClientId": "<your AppID>",
    "ClientSecret": "",
    "AcceptedAuds": [
      "<AppID of the CIAM-extention-auth-app>"
    ],
    "AcceptedSigninAppIDs": [
      "<AppID of the client app bound to the User Flow>",
      "<...can be multiple...>"
    ]

  },

  "Entra.Workforce": {
    "TenantId": "<tenantID of your workforce tenant for KeyVault, O365 mail>"
  },

  "O365Mail": {
    "Enabled": false,
    "ClientId": "<AppID of app with permission Microsoft Grap Application Mail.Send>",
    "ClientSecret": "...",
    "SenderEmail": "noreply@contoso.com",
    "EmailTemplate": "otpemail.html",
    "EmailSubject": "Your {{APP}} account verification code",
    "OtpTtlMinutes": "10"
  },

  "KeyVault": {
    "Enabled": true,
    "ClientId": "<AppID of the service principal you have grantet Get Secret access in your KeyVault>",
    "ClientSecret": "...",
    "KeyVaultUrl": "https://your-name.vault.azure.net/",
    "CertificateName": "JitMigrationEncryptionCert"
  },

  "Twilio": {
    "Enabled": false,
    "Sid": "...",
    "Token": "...",
    "Number": "+..."
  },

  "Auth0": {
    "TenantDomain": "... .auth0.com",
    "ClientId": "....",
    "ClientSecret": "..."
  }


}